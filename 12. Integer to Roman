class Solution {
public:
    string intToRoman(int num) {
        struct Roman{
            int value;
            string symbol;
        };

        vector<Roman> table = {
            {1000, "M"}, {900, "CM"}, {500, "D"},
            {400, "CD"}, {100, "C"}, {90, "XC"},
            {50, "L"}, {40, "XL"}, {10, "X"},
            {9, "IX"}, {5, "V"}, {4, "IV"}, {1, "I"}
        };

        string result = "";
        for(const auto& item : table){
            while(num >= item.value){
                num -= item.value;
                result += item.symbol;
            }
        }
        return result;
    }
};
